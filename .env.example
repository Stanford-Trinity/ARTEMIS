# ============================================================================
# API Configuration - Choose ONE of the following providers:
# ============================================================================

# Option 1: OpenRouter API Configuration
OPENROUTER_API_KEY=your-openrouter-api-key-here

# Option 2: OpenAI API Configuration (uncomment to use)
# OPENAI_API_KEY=your-openai-api-key-here

# Option 3: Azure OpenAI API Configuration (uncomment to use)
# AZURE_OPENAI_API_KEY=your-azure-openai-api-key-here
# AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com
# AZURE_OPENAI_API_VERSION=2024-10-01-preview

# ============================================================================
# Model Configuration (Optional Overrides)
# ============================================================================

# Override default models (use deployment names for Azure)
# SUPERVISOR_MODEL=openai/o1-preview          # For OpenRouter
# SUPERVISOR_MODEL=o4-mini                     # For OpenAI
# SUPERVISOR_MODEL=gpt-4                       # For Azure (deployment name)

# SUMMARIZATION_MODEL=openai/o4-mini          # For OpenRouter
# SUMMARIZATION_MODEL=o4-mini                  # For OpenAI
# SUMMARIZATION_MODEL=gpt-4                    # For Azure (deployment name)

# ROUTER_MODEL=openai/o4-mini                 # For OpenRouter
# ROUTER_MODEL=o4-mini                         # For OpenAI
# ROUTER_MODEL=gpt-4                           # For Azure (deployment name)

# ============================================================================
# TODO Generator Model Configuration (Optional)
# ============================================================================

# TODO_GENERATOR_OPENROUTER_MODEL=anthropic/claude-opus-4.1
# TODO_GENERATOR_OPENAI_MODEL=gpt-5
# TODO_GENERATOR_AZURE_MODEL=gpt-4             # Azure deployment name

# ============================================================================
# Prompt Generator Model Configuration (Optional)
# ============================================================================

# PROMPT_GENERATOR_MODEL=anthropic/claude-opus-4.1

# ============================================================================
# Available Models for Model Switching (Optional, comma-separated)
# ============================================================================

# For OpenRouter
# OPENROUTER_AVAILABLE_MODELS=anthropic/claude-sonnet-4,openai/o3,anthropic/claude-opus-4,google/gemini-2.5-pro,openai/o3-pro

# For OpenAI Direct
# OPENAI_AVAILABLE_MODELS=o3,gpt-5

# For Azure (use your deployment names)
# AZURE_AVAILABLE_MODELS=gpt-4,gpt-4-turbo,gpt-35-turbo